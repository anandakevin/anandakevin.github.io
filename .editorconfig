root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{astro,js,mjs,cjs,ts,tsx}]
indent_size = 2
max_line_length = 100

[*.{css,scss}]
indent_size = 2
max_line_length = 100

[*.{html,svg}]
indent_size = 2
max_line_length = 100

[*.{json,jsonc,yml,yaml}]
indent_size = 2
max_line_length = 100

[*.md]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

[*.{sh,bash,zsh}]
indent_size = 2
max_line_length = 100

[Makefile]
indent_style = tab
