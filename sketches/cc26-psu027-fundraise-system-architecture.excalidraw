      "updated": 1778083632344,
      "link": null,
      "locked": false,
      "text": "import pandas as pd\nimport numpy as np\nfrom sklearn.metrics.pairwise import cosine_similarity\nimport joblib\n\n# --- Persiapan Umum: Mendapatkan Preprocessor dan Feature Order ---\n# Feature_Order sudah didefinisikan sebelumnya di sel 'CBujq2GRR-ve'\nFeature_Order = [\n    'net_profit_margin',\n    'kepuasan_pelanggan',\n    'peak_hour_latency',\n    'review_volatility',\n    'repeat_order_rate',\n    'digital_adoption_score',\n    'year_revenue',\n    'business_tenure_years'\n]\n\n# Memuat Preprocessor dari pipeline.joblib jika belum dimuat\n# Objek 'Preprocessor' dan 'Bundle' seharusnya sudah dimuat\n# Namun, untuk memastikan modularitas jika kode ini dijalankan terpisah, kita coba muat lagi.\ntry:\n    # Only load if Preprocessor is not already defined in the global or local scope\n    if 'Preprocessor' not in locals() and 'Preprocessor' not in globals():\n        Bundle = joblib.load(\"pipeline.joblib\")\n        Preprocessor = Bundle[\"preprocessor\"]\n        print(\"Preprocessor loaded successfully.\")\nexcept FileNotFoundError:\n    print(\"Error: pipeline.joblib not found. Please ensure it's available in the current directory.\")\n    # Exit or handle error appropriately in a real application\nexcept Exception as e:\n    print(f\"Error loading Preprocessor: {e}\")\n\n# --- 1. Fungsi Data Preparation: Mendapatkan Fitur Katalog UMKM (sudah ter-scaling) ---\ndef get_umkm_catalog_features(umkm_dataframe: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Mengambil fitur-fitur yang relevan dari DataFrame UMKM yang sudah ter-scaling.\n    Asumsi: umkm_dataframe (dari test.csv) sudah berisi fitur-fitur yang ter-scaling.\n\n    Args:\n        umkm_dataframe (pd.DataFrame): DataFrame yang berisi data UMKM asli (sudah diskalakan).\n\n    Returns:\n        pd.DataFrame: DataFrame dengan 'id_bisnis' dan fitur-fitur ter-scaling.\n    \"\"\"\n    print(\"Mengambil fitur katalog UMKM (asumsi sudah ter-scaling)...\")\n    # Pastikan urutan fitur sama dengan saat training, dan tambahkan ID\n    # Kita tidak perlu memanggil preprocessor.transform lagi karena data sudah discale.\n    scaled_features_df = umkm_dataframe[Feature_Order].copy()\n    scaled_features_df['id_bisnis'] = umkm_dataframe.index\n    print(\"Fitur katalog UMKM siap.\")\n    return scaled_features_df\n\n# --- 2. Fungsi Investor Input Handling: Mengubah Preferensi Investor menjadi Vektor ---\ndef process_investor_preferences(investor_preferences: dict, preprocessor) -> np.ndarray:\n    \"\"\"\n    Mengubah dictionary preferensi investor menjadi vektor fitur yang sudah ter-scaling.\n\n    Args:\n        investor_preferences (dict): Dictionary preferensi investor dalam format raw.\n        preprocessor: Objek preprocessor yang sudah dilatih (dari joblib).\n\n    Returns:\n        np.ndarray: Vektor fitur preferensi investor yang sudah ter-scaling.\n    \"\"\"\n    print(\"Memproses preferensi investor...\")\n    # Membuat DataFrame dari preferensi investor\n    # Pastikan urutan kolom sesuai dengan Feature_Order\n    investor_df = pd.DataFrame([investor_preferences], columns=Feature_Order)\n\n    # Scaling preferensi menggunakan preprocessor yang sama\n    scaled_preferences = preprocessor.transform(investor_df)\n\n    print(\"Preferensi investor diproses.\")\n    return scaled_preferences[0] # Mengembalikan sebagai array 1D\n\n# --- 3. Fungsi Core Logic: Menghitung Cosine Similarity ---\ndef calculate_cosine_similarity(vec1: np.ndarray, vec2: np.ndarray) -> float:\n    \"\"\"\n    Menghitung cosine similarity antara dua vektor.\n    Fungsi ini digunakan secara internal oleh fungsi rekomendasi.\n\n    Args:\n        vec1 (np.ndarray): Vektor pertama.\n        vec2 (np.ndarray): Vektor kedua.\n\n    Returns:\n        float: Nilai cosine similarity.\n    \"\"\"\n    # Fungsi cosine_similarity dari sklearn menerima input 2D array, jadi kita reshape\n    if vec1.ndim == 1:\n        vec1 = vec1.reshape(1, -1)\n    if vec2.ndim == 1:\n        vec2 = vec2.reshape(1, -1)\n\n    similarity = cosine_similarity(vec1, vec2)[0][0]\n    return similarity\n\n# --- 4. Fungsi Utama Rekomendasi UMKM ---\ndef recommend_umkm(investor_id: str, investor_preferences: dict, umkm_dataframe: pd.DataFrame, preprocessor) ->\npd.DataFrame:\n    \"\"\"\n    Memberikan rekomendasi UMKM berdasarkan preferensi investor.\n\n    Args:\n        investor_id (str): ID unik untuk investor.\n        investor_preferences (dict): Dictionary preferensi investor.\n        umkm_dataframe (pd.DataFrame): DataFrame yang berisi data UMKM asli (misal: dari test.csv).\n        preprocessor: Objek preprocessor yang sudah dilatih (dari joblib).\n\n    Returns:\n        pd.DataFrame: DataFrame berisi 'id_user', 'id_bisnis', dan 'skor_kecocokan',\n                      diurutkan dari skor tertinggi (skala 0-100).\n    \"\"\"\n    print(f\"Memulai proses rekomendasi untuk investor: {investor_id}...\")\n\n    # 1. Siapkan katalog UMKM yang sudah ter-scaling\n    # umkm_dataframe (yaitu test_raw_data) diasumsikan sudah ter-scaling/terproses\n    umkm_catalog_processed = get_umkm_catalog_features(umkm_dataframe)\n\n    # 2. Proses preferensi investor menjadi vektor yang ter-scaling\n    investor_vector_scaled = process_investor_preferences(investor_preferences, preprocessor)\n\n    # 3. Hitung skor kecocokan (Cosine Similarity)\n    # Convert investor_vector_scaled to a 2D array for cosine_similarity with multiple UMKM features\n    investor_vector_scaled_2d = investor_vector_scaled.reshape(1, -1)\n\n    # Ekstrak hanya fitur untuk perhitungan similarity dari umkm_catalog_processed\n    umkm_features_scaled = umkm_catalog_processed[Feature_Order].to_numpy()\n\n    # Hitung cosine similarity antara vektor investor dan semua vektor UMKM\n    similarities = cosine_similarity(investor_vector_scaled_2d, umkm_features_scaled)[0]\n\n    # Skala skor kecocokan dari rentang [-1, 1] menjadi [0, 100]\n    # Formula: ((similarity + 1) / 2) * 100\n    scaled_scores = ((similarities + 1) / 2) * 100\n\n    # 4. Buat DataFrame hasil rekomendasi\n    recommendations = pd.DataFrame({\n        'id_user': investor_id,\n        'id_bisnis': umkm_catalog_processed['id_bisnis'],\n        'skor_kecocokan': scaled_scores\n    })\n\n    # Urutkan berdasarkan skor kecocokan tertinggi\n    recommendations = recommendations.sort_values(by='skor_kecocokan', ascending=False).reset_index(drop=True)\n\n    print(\"Rekomendasi selesai.\")\n    return recommendations\n\n# --- Contoh Penggunaan Modul Sistem Rekomendasi ---\n# Investor memiliki preferensi target profit margin tinggi, kepuasan pelanggan tinggi,\n# latensi rendah, volatilitas review rendah, repeat order tinggi, adopsi digital tinggi,\n# revenue tinggi, dan masa bisnis yang lama.\n# Nilai-nilai ini adalah raw (mentah) dan akan diskalakan oleh preprocessor.\ninvestor_example_preferences = {\n    'net_profit_margin': 0.8,         # Contoh: 80% Net Profit Margin\n    'kepuasan_pelanggan': 5.0,        # Contoh: Skor kepuasan 5 (dari skala 1-5)\n    'peak_hour_latency': 'low',         # Contoh: Latensi 'low' (sebelum diskalakan)\n    'review_volatility': 0.1,         # Contoh: Volatilitas review rendah\n    'repeat_order_rate': 0.9,         # Contoh: 90% repeat order rate\n    'digital_adoption_score': 9.0,    # Contoh: Skor adopsi digital 9 (dari skala 1-10)\n    'year_revenue': 2000000000,       # Contoh: Revenue 2 Milyar IDR\n    'business_tenure_years': 40       # Contoh: Masa bisnis 40 tahun\n}\n\n# Definisikan ID investor\ninvestor_id = \"investor_001\"\n\n# Memuat ulang dataset test.csv dalam keadaan mentah (raw) agar sesuai dengan ekspektasi preprocessor\n# 'test_output_file' sudah didefinisikan sebagai \"test.csv\"\ntest_raw_data = pd.read_csv(test_output_file)\n\nprint(\"Menghasilkan rekomendasi UMKM untuk investor_001...\")\nrecommendations_df = recommend_umkm(\n    investor_id,\n    investor_example_preferences,\n    test_raw_data, # Menggunakan DataFrame 'test_raw_data' yang belum diproses\n    Preprocessor  # Menggunakan objek 'Preprocessor'\n)\n\n# Menampilkan 5 rekomendasi teratas\nprint(\"\\nTop 5 Rekomendasi UMKM:\")\nprint(recommendations_df.head(100))",
      "fontSize": 23.895652439283268,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import pandas as pd\nimport numpy as np\nfrom sklearn.metrics.pairwise import cosine_similarity\nimport joblib\n\n# --- Persiapan Umum: Mendapatkan Preprocessor dan Feature Order ---\n# Feature_Order sudah didefinisikan sebelumnya di sel 'CBujq2GRR-ve'\nFeature_Order = [\n    'net_profit_margin',\n    'kepuasan_pelanggan',\n    'peak_hour_latency',\n    'review_volatility',\n    'repeat_order_rate',\n    'digital_adoption_score',\n    'year_revenue',\n    'business_tenure_years'\n]\n\n# Memuat Preprocessor dari pipeline.joblib jika belum dimuat\n# Objek 'Preprocessor' dan 'Bundle' seharusnya sudah dimuat\n# Namun, untuk memastikan modularitas jika kode ini dijalankan terpisah, kita coba muat lagi.\ntry:\n    # Only load if Preprocessor is not already defined in the global or local scope\n    if 'Preprocessor' not in locals() and 'Preprocessor' not in globals():\n        Bundle = joblib.load(\"pipeline.joblib\")\n        Preprocessor = Bundle[\"preprocessor\"]\n        print(\"Preprocessor loaded successfully.\")\nexcept FileNotFoundError:\n    print(\"Error: pipeline.joblib not found. Please ensure it's available in the current directory.\")\n    # Exit or handle error appropriately in a real application\nexcept Exception as e:\n    print(f\"Error loading Preprocessor: {e}\")\n\n# --- 1. Fungsi Data Preparation: Mendapatkan Fitur Katalog UMKM (sudah ter-scaling) ---\ndef get_umkm_catalog_features(umkm_dataframe: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Mengambil fitur-fitur yang relevan dari DataFrame UMKM yang sudah ter-scaling.\n    Asumsi: umkm_dataframe (dari test.csv) sudah berisi fitur-fitur yang ter-scaling.\n\n    Args:\n        umkm_dataframe (pd.DataFrame): DataFrame yang berisi data UMKM asli (sudah diskalakan).\n\n    Returns:\n        pd.DataFrame: DataFrame dengan 'id_bisnis' dan fitur-fitur ter-scaling.\n    \"\"\"\n    print(\"Mengambil fitur katalog UMKM (asumsi sudah ter-scaling)...\")\n    # Pastikan urutan fitur sama dengan saat training, dan tambahkan ID\n    # Kita tidak perlu memanggil preprocessor.transform lagi karena data sudah discale.\n    scaled_features_df = umkm_dataframe[Feature_Order].copy()\n    scaled_features_df['id_bisnis'] = umkm_dataframe.index\n    print(\"Fitur katalog UMKM siap.\")\n    return scaled_features_df\n\n# --- 2. Fungsi Investor Input Handling: Mengubah Preferensi Investor menjadi Vektor ---\ndef process_investor_preferences(investor_preferences: dict, preprocessor) -> np.ndarray:\n    \"\"\"\n    Mengubah dictionary preferensi investor menjadi vektor fitur yang sudah ter-scaling.\n\n    Args:\n        investor_preferences (dict): Dictionary preferensi investor dalam format raw.\n        preprocessor: Objek preprocessor yang sudah dilatih (dari joblib).\n\n    Returns:\n        np.ndarray: Vektor fitur preferensi investor yang sudah ter-scaling.\n    \"\"\"\n    print(\"Memproses preferensi investor...\")\n    # Membuat DataFrame dari preferensi investor\n    # Pastikan urutan kolom sesuai dengan Feature_Order\n    investor_df = pd.DataFrame([investor_preferences], columns=Feature_Order)\n\n    # Scaling preferensi menggunakan preprocessor yang sama\n    scaled_preferences = preprocessor.transform(investor_df)\n\n    print(\"Preferensi investor diproses.\")\n    return scaled_preferences[0] # Mengembalikan sebagai array 1D\n\n# --- 3. Fungsi Core Logic: Menghitung Cosine Similarity ---\ndef calculate_cosine_similarity(vec1: np.ndarray, vec2: np.ndarray) -> float:\n    \"\"\"\n    Menghitung cosine similarity antara dua vektor.\n    Fungsi ini digunakan secara internal oleh fungsi rekomendasi.\n\n    Args:\n        vec1 (np.ndarray): Vektor pertama.\n        vec2 (np.ndarray): Vektor kedua.\n\n    Returns:\n        float: Nilai cosine similarity.\n    \"\"\"\n    # Fungsi cosine_similarity dari sklearn menerima input 2D array, jadi kita reshape\n    if vec1.ndim == 1:\n        vec1 = vec1.reshape(1, -1)\n    if vec2.ndim == 1:\n        vec2 = vec2.reshape(1, -1)\n\n    similarity = cosine_similarity(vec1, vec2)[0][0]\n    return similarity\n\n# --- 4. Fungsi Utama Rekomendasi UMKM ---\ndef recommend_umkm(investor_id: str, investor_preferences: dict, umkm_dataframe: pd.DataFrame, preprocessor) ->\npd.DataFrame:\n    \"\"\"\n    Memberikan rekomendasi UMKM berdasarkan preferensi investor.\n\n    Args:\n        investor_id (str): ID unik untuk investor.\n        investor_preferences (dict): Dictionary preferensi investor.\n        umkm_dataframe (pd.DataFrame): DataFrame yang berisi data UMKM asli (misal: dari test.csv).\n        preprocessor: Objek preprocessor yang sudah dilatih (dari joblib).\n\n    Returns:\n        pd.DataFrame: DataFrame berisi 'id_user', 'id_bisnis', dan 'skor_kecocokan',\n                      diurutkan dari skor tertinggi (skala 0-100).\n    \"\"\"\n    print(f\"Memulai proses rekomendasi untuk investor: {investor_id}...\")\n\n    # 1. Siapkan katalog UMKM yang sudah ter-scaling\n    # umkm_dataframe (yaitu test_raw_data) diasumsikan sudah ter-scaling/terproses\n    umkm_catalog_processed = get_umkm_catalog_features(umkm_dataframe)\n\n    # 2. Proses preferensi investor menjadi vektor yang ter-scaling\n    investor_vector_scaled = process_investor_preferences(investor_preferences, preprocessor)\n\n    # 3. Hitung skor kecocokan (Cosine Similarity)\n    # Convert investor_vector_scaled to a 2D array for cosine_similarity with multiple UMKM features\n    investor_vector_scaled_2d = investor_vector_scaled.reshape(1, -1)\n\n    # Ekstrak hanya fitur untuk perhitungan similarity dari umkm_catalog_processed\n    umkm_features_scaled = umkm_catalog_processed[Feature_Order].to_numpy()\n\n    # Hitung cosine similarity antara vektor investor dan semua vektor UMKM\n    similarities = cosine_similarity(investor_vector_scaled_2d, umkm_features_scaled)[0]\n\n    # Skala skor kecocokan dari rentang [-1, 1] menjadi [0, 100]\n    # Formula: ((similarity + 1) / 2) * 100\n    scaled_scores = ((similarities + 1) / 2) * 100\n\n    # 4. Buat DataFrame hasil rekomendasi\n    recommendations = pd.DataFrame({\n        'id_user': investor_id,\n        'id_bisnis': umkm_catalog_processed['id_bisnis'],\n        'skor_kecocokan': scaled_scores\n    })\n\n    # Urutkan berdasarkan skor kecocokan tertinggi\n    recommendations = recommendations.sort_values(by='skor_kecocokan', ascending=False).reset_index(drop=True)\n\n    print(\"Rekomendasi selesai.\")\n    return recommendations\n\n# --- Contoh Penggunaan Modul Sistem Rekomendasi ---\n# Investor memiliki preferensi target profit margin tinggi, kepuasan pelanggan tinggi,\n# latensi rendah, volatilitas review rendah, repeat order tinggi, adopsi digital tinggi,\n# revenue tinggi, dan masa bisnis yang lama.\n# Nilai-nilai ini adalah raw (mentah) dan akan diskalakan oleh preprocessor.\ninvestor_example_preferences = {\n    'net_profit_margin': 0.8,         # Contoh: 80% Net Profit Margin\n    'kepuasan_pelanggan': 5.0,        # Contoh: Skor kepuasan 5 (dari skala 1-5)\n    'peak_hour_latency': 'low',         # Contoh: Latensi 'low' (sebelum diskalakan)\n    'review_volatility': 0.1,         # Contoh: Volatilitas review rendah\n    'repeat_order_rate': 0.9,         # Contoh: 90% repeat order rate\n    'digital_adoption_score': 9.0,    # Contoh: Skor adopsi digital 9 (dari skala 1-10)\n    'year_revenue': 2000000000,       # Contoh: Revenue 2 Milyar IDR\n    'business_tenure_years': 40       # Contoh: Masa bisnis 40 tahun\n}\n\n# Definisikan ID investor\ninvestor_id = \"investor_001\"\n\n# Memuat ulang dataset test.csv dalam keadaan mentah (raw) agar sesuai dengan ekspektasi preprocessor\n# 'test_output_file' sudah didefinisikan sebagai \"test.csv\"\ntest_raw_data = pd.read_csv(test_output_file)\n\nprint(\"Menghasilkan rekomendasi UMKM untuk investor_001...\")\nrecommendations_df = recommend_umkm(\n    investor_id,\n    investor_example_preferences,\n    test_raw_data, # Menggunakan DataFrame 'test_raw_data' yang belum diproses\n    Preprocessor  # Menggunakan objek 'Preprocessor'\n)\n\n# Menampilkan 5 rekomendasi teratas\nprint(\"\\nTop 5 Rekomendasi UMKM:\")\nprint(recommendations_df.head(100))",
