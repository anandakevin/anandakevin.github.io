    {
      "id": "8nt6W8om",
      "type": "text",
      "x": 4553.141601174531,
      "y": 4498.916591363174,
      "width": 1485.8782742394355,
      "height": 5496.000061035152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
