---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SketchCard from '../../components/SketchCard.astro';
import { getSketchItems, isFixtureMode } from '../../lib/content';

const sketches = await getSketchItems();
const tags = [...new Set(sketches.flatMap((sketch) => sketch.tags))].sort();
---

<BaseLayout
  title="Sketches"
  description="Interactive architecture models, debugging maps, teaching whiteboards, and visual explanations."
>
  <section class="page-hero sketch-index-hero">
    <div class="shell">
      <p class="page-crumb">Sketches</p>
      <h1 class="display">
        Thinking made <em>visible.</em>
      </h1>
      <p class="lede">
        Architecture models, debugging maps, teaching whiteboards, and rough visual explanations
        drawn while figuring out how systems fit together. Each sketch is a canonical artifact that
        can stand alone here or appear inside work, writing, projects, and contributions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell" data-sketch-index>
      <div class="sketch-index-intro">
        <div>
          <p class="section-index">01 / Visual library</p>
          <h2>Browse the sketches.</h2>
        </div>
        <p>
          The drawing is the primary artifact. The surrounding text only records enough context to
          place it.
        </p>
      </div>
      {sketches.length > 0 && (
        <div class="sketch-controls" role="search">
          <input
            class="sketch-search"
            type="search"
            placeholder="Search sketches…"
            aria-label="Search sketches"
            data-sketch-search
          />
          <button class="sketch-filter is-active" type="button" data-sketch-filter="all">
            All
          </button>
          {tags.map((tag) => (
            <button class="sketch-filter" type="button" data-sketch-filter={tag}>
              {tag}
            </button>
          ))}
        </div>
      )}
      <div class="sketch-grid">
        {sketches.map((sketch) => (
          <SketchCard sketch={sketch} />
        ))}
      </div>
      {isFixtureMode || sketches.length === 0 ? (
        <p class="signal-empty-stats">I’m still preparing the first sketches to publish here.</p>
      ) : (
        <p class="sketch-index-note">
          Sketches stay useful outside a single article. Open one for the full canvas, its usage
          provenance, related artifacts, and its place in the Semantic Atlas.
        </p>
      )}
      <div class="actions atlas-index-action">
        <a class="button alt" href="/explore">
          Explore these in the atlas →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initSketchIndex() {
    const root = document.querySelector<HTMLElement>('[data-sketch-index]');
    if (!root || root.dataset.sketchIndexReady === 'true') return;
    root.dataset.sketchIndexReady = 'true';
    const search = root.querySelector<HTMLInputElement>('[data-sketch-search]');
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-sketch-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-sketch-card]')];
    let filter = 'all';
    const apply = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      cards.forEach((card) => {
        const haystack = `${card.textContent ?? ''} ${card.dataset.sketchTags ?? ''}`.toLowerCase();
        const matchesFilter =
          filter === 'all' || (card.dataset.sketchTags ?? '').split(' ').includes(filter);
        card.toggleAttribute(
          'hidden',
          !matchesFilter || (query.length > 0 && !haystack.includes(query)),
        );
      });
    };
    search?.addEventListener('input', apply);
    filters.forEach((button) =>
      button.addEventListener('click', () => {
        filter = button.dataset.sketchFilter ?? 'all';
        filters.forEach((candidate) =>
          candidate.classList.toggle('is-active', candidate === button),
        );
        apply();
      }),
    );
  }
  initSketchIndex();
  document.addEventListener('astro:page-load', initSketchIndex);
</script>
