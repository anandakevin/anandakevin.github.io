---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---
<BaseLayout title="Credentials & Recognition" description="Implementation fixture verification surface."><section class="page-hero"><div class="shell"><p class="page-crumb">Credentials & Recognition / verification</p><h1 class="display">Evidence should verify the story, not <em>become the story.</em></h1><p class="lede">No credential, award, research item, or recognition claim is populated until its approved record exists.</p></div></section><section class="section"><div class="shell"><SectionHeader index="01 / Verification" title="Direct evidence, not a" emphasis="certificate dump." /><div class="three-grid"><article class="artifact-card"><small>Fixture only</small><h3>Verification groups</h3><p>Components support public verification links without copying raw files or creating badge walls.</p></article></div></div></section></BaseLayout>
