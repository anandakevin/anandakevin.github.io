---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CredentialsHeroVisual from '../components/CredentialsHeroVisual.astro';
import { getCredentialItems, hrefForCredentialCard, isFixtureMode } from '../lib/content';

const credentials = await getCredentialItems();
const certificationCredentials = credentials.filter((item) => !item.tags.includes('research'));
const researchCredentials = credentials.filter((item) => item.tags.includes('research'));
const teachingCredentials = credentials.filter((item) => item.tags.includes('teaching'));
---

<BaseLayout
  title="Credentials"
  description="Degrees, certifications, publications, and awards, with verification where relevant."
>
  <section class="page-hero">
    <div class="shell credentials-hero-grid">
      <div>
        <p class="page-crumb">Credentials</p>
        <h1 class="display">
          Credentials, research, and <em>recognition.</em>
        </h1>
        <p class="lede">
          Degrees, certifications, publications, and awards, with verification where relevant.
        </p>
      </div>
      <CredentialsHeroVisual />
    </div>
  </section>
  <section class="section" id="credentials">
    <div class="shell">
      <SectionHeader
        index="01 / Education & recognition"
        title="Education &"
        emphasis="recognition."
      />
      <div class="profile-grid">
        {certificationCredentials.length > 0 ? (
          certificationCredentials.map((item) => (
            <article class="profile-card">
              <span class="profile-cap">{item.tags[0]?.replace(/-/g, ' ') ?? 'Credential'}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a
                href={hrefForCredentialCard(item)}
                rel={item.verification_url ? 'noopener noreferrer' : undefined}
                target={item.verification_url ? '_blank' : undefined}
              >
                {item.verification_url?.includes('credly.com')
                  ? 'Verify on Credly ↗'
                  : item.verification_url
                    ? 'Verify ↗'
                    : 'Open record ↗'}
              </a>
            </article>
          ))
        ) : (
          <article class="profile-card">
            <span class="profile-cap">Credentials</span>
            <h3>Credentials & recognition</h3>
            <p>Education, awards, and certifications curated for public verification.</p>
            {isFixtureMode && <span class="profile-pending">Fixture shell</span>}
          </article>
        )}
        {teachingCredentials.map((item) => (
          <article class="profile-card">
            <span class="profile-cap">Teaching</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a
              href={hrefForCredentialCard(item)}
              rel={item.verification_url ? 'noopener noreferrer' : undefined}
              target={item.verification_url ? '_blank' : undefined}
            >
              {item.verification_url ? 'Verify ↗' : 'Open record ↗'}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  {researchCredentials.length > 0 && (
    <section class="section" id="research">
      <div class="shell">
        <SectionHeader
          index="02 / Research publications"
          title="Research &"
          emphasis="publications."
        />
        <div class="profile-grid">
          {researchCredentials.map((item) => (
            <article class="profile-card">
              <span class="profile-cap">Research</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a
                href={hrefForCredentialCard(item)}
                rel={item.verification_url ? 'noopener noreferrer' : undefined}
                target={item.verification_url ? '_blank' : undefined}
              >
                {item.verification_url ? 'Verify on Google Scholar ↗' : 'Open record ↗'}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
