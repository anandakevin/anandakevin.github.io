---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WorkCard from '../components/WorkCard.astro';
import { fixtureWork } from '../data/fixtures';
---
<BaseLayout title="Work" description="Implementation fixture work surface."><section class="page-hero"><div class="shell"><p class="page-crumb">Work / full chronology + selected evidence</p><h1 class="display">Work is where the <em>systems</em> become concrete.</h1><p class="lede">Fixture-only chronology validates the page family. Reviewed public role records will replace it before release.</p></div></section><section class="section"><div class="shell"><div class="work-list">{fixtureWork.map((item) => <WorkCard item={item} signal="fixture → evidence" />)}</div></div></section><section class="section"><div class="shell"><SectionHeader index="Related depth" title="Writing explains the" emphasis="decisions." /><a class="button alt" href="/writing">Browse Writing ↗</a></div></section></BaseLayout>
