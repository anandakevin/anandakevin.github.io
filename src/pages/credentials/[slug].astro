---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageCrumb from '../../components/PageCrumb.astro';
import AtlasNeighborhood from '../../components/AtlasNeighborhood.astro';
import MarkdownBody from '../../components/MarkdownBody.astro';
import PublicLinks from '../../components/PublicLinks.astro';
import PublicMedia from '../../components/PublicMedia.astro';
import {
  entryToPublicContent,
  getCredentialDetailEntriesForRoutes,
  getRecordsById,
  isFixtureMode,
  slugTail,
} from '../../lib/content';

export async function getStaticPaths() {
  if (isFixtureMode) return [];
  const entries = await getCredentialDetailEntriesForRoutes();
  return entries.map((entry) => ({
    params: { slug: slugTail(entry.data.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const byId = await getRecordsById();
const { Content } = await render(entry);
const item = entry.data;
---

<BaseLayout title={item.title} description={item.description}>
  <section class="page-hero">
    <div class="shell">
      <PageCrumb icon="credential">Credentials / {item.title}</PageCrumb>
      <h1 class="display">{item.title}</h1>
      <p class="lede">{item.description}</p>
      <div class="detail-pills">
        {item.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <MarkdownBody>
        <Content />
      </MarkdownBody>
      <PublicMedia media={item.media} />
      <PublicLinks links={item.public_links} verificationUrl={item.verification_url} />
      <div class="actions">
        <a class="button alt" href="/credentials">
          Back to credentials ↗
        </a>
      </div>
    </div>
  </section>
  <AtlasNeighborhood item={entryToPublicContent(entry)} records={[...byId.values()]} />
</BaseLayout>
