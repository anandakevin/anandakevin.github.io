---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownBody from '../../components/MarkdownBody.astro';
import PublicLinks from '../../components/PublicLinks.astro';
import PublicMedia from '../../components/PublicMedia.astro';
import AtlasNeighborhood from '../../components/AtlasNeighborhood.astro';
import SketchEmbeds from '../../components/SketchEmbeds.astro';
import {
  entryToPublicContent,
  getProjectEntriesForRoutes,
  getRecordsById,
  isFixtureMode,
  resolveRelations,
  slugTail,
  sketchesUsedIn,
} from '../../lib/content';

export async function getStaticPaths() {
  if (isFixtureMode) return [];
  const entries = await getProjectEntriesForRoutes();
  return entries.map((entry) => ({
    params: { slug: slugTail(entry.data.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const byId = await getRecordsById();
const { Content } = await render(entry);
const item = entry.data;
const resolved = resolveRelations(entryToPublicContent(entry), byId);
const relatedWriting = resolved.filter(
  (link) =>
    link.targetId.startsWith('writing/') &&
    ['related_to', 'related_implementation', 'derived_from'].includes(link.relation),
);
const embeddedSketches = sketchesUsedIn([...byId.values()], entry.data.id);
---

<BaseLayout title={item.title} description={item.description}>
  <section class="page-hero">
    <div class="shell">
      <p class="page-crumb">Projects / {item.title}</p>
      <h1 class="display">{item.title}</h1>
      <p class="lede">{item.description}</p>
      <div class="detail-pills">
        {item.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <MarkdownBody>
        <Content />
      </MarkdownBody>
      <SketchEmbeds sketches={embeddedSketches} />
      <PublicMedia media={item.media} />
      <PublicLinks links={item.public_links} verificationUrl={item.verification_url} />
      {relatedWriting.length > 0 && (
        <div class="actions">
          {relatedWriting.map((link) => (
            <a class="button alt" href={link.href}>
              {link.record.title} ↗
            </a>
          ))}
        </div>
      )}
      <div class="actions">
        <a class="button alt" href="/projects">
          Back to projects ↗
        </a>
      </div>
    </div>
  </section>
  <AtlasNeighborhood item={entryToPublicContent(entry)} records={[...byId.values()]} />
</BaseLayout>
