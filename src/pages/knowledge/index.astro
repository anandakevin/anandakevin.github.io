---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageCrumb from '../../components/PageCrumb.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SemanticIcon from '../../components/SemanticIcon.astro';
import KnowledgeSearch from '../../components/KnowledgeSearch.astro';
import { knowledgeKindLabel, knowledgePathLabel } from '../../data/knowledge';
import {
  getCuratedKnowledgeStartHere,
  getKnowledgeDomainItems,
  getKnowledgeItems,
  getPageEntryById,
  isFixtureMode,
  pageHeroFromEntry,
  pageLedeFromEntry,
} from '../../lib/content';

const domains = (await getKnowledgeDomainItems()).sort((left, right) =>
  left.title.localeCompare(right.title),
);
const pages = await getKnowledgeItems();
const startHere = await getCuratedKnowledgeStartHere();
const page = await getPageEntryById('pages/knowledge');
const hero = pageHeroFromEntry(page);
const domainTitleById = new Map(domains.map((domain) => [domain.knowledge_domain, domain.title]));
const pageCountLabel = (count: number) => `${count} ${count === 1 ? 'page' : 'pages'}`;
---

<BaseLayout
  title={page?.data.title ?? 'Knowledge'}
  description={
    isFixtureMode
      ? 'Fixture reference library for testing domains, reading paths, and Knowledge navigation.'
      : (page?.data.description ??
        'A public reference library for reusable explanations, concepts, guides, and playbooks.')
  }
>
  <KnowledgeSearch />
  <section class="page-hero knowledge-hero">
    <div class="shell">
      <PageCrumb icon="knowledge">Knowledge / public reference library</PageCrumb>
      {hero ? (
        <h1 class="display">
          {hero.headline_before} <em>{hero.emphasis}</em>
          {hero.headline_after}
        </h1>
      ) : (
        <h1 class="display">
          Ideas arranged for <em>reuse.</em>
        </h1>
      )}
      <p class="lede">
        {pageLedeFromEntry(
          page,
          'A growing library of explanations, concepts, guides, and references. Browse by domain when you want a map, or search directly for a page.',
        )}
      </p>
      <div class="knowledge-global-search" aria-label="Knowledge search">
        <span class="knowledge-global-search-label">Search Knowledge</span>
        <button
          type="button"
          class="knowledge-search-launcher"
          data-knowledge-search-trigger
          aria-haspopup="dialog"
          aria-controls="knowledge-search-dialog"
          aria-expanded="false"
          aria-keyshortcuts="Meta+K Control+K"
        >
          <span>Search Knowledge…</span>
          <kbd>⌘K</kbd>
        </button>
        <small>
          Search is global. Press <kbd>⌘K</kbd> or <kbd>Ctrl K</kbd> from any Knowledge page.
        </small>
      </div>
    </div>
  </section>

  <section class="section knowledge-section" id="knowledge-domains">
    <div class="shell">
      <SectionHeader
        index="01 / Browse"
        title="Explore by"
        emphasis="domain."
        icon="knowledge"
        description="Domains provide the broad map. They are editorial navigation, not a mirror of folders or a permanent URL hierarchy."
      />
      <div class="knowledge-domain-grid">
        {domains.map((domain) => {
          const domainPages = pages.filter(
            (page) => page.knowledge_domain === domain.knowledge_domain,
          );
          const areaLabels = (domain.knowledge_areas ?? []).slice(0, 3).map((area) => area.title);
          return (
            <a class="knowledge-domain-card" href={`/knowledge/domain/${domain.knowledge_domain}`}>
              <span class="knowledge-card-cap">Domain · {pageCountLabel(domainPages.length)}</span>
              <span class="knowledge-card-arrow" aria-hidden="true">
                ↗
              </span>
              <div class="content-item-title">
                <SemanticIcon name="knowledge" />
                <h3>{domain.title}</h3>
              </div>
              <p>{domain.description}</p>
              <span class="knowledge-card-meta">
                {areaLabels.map((label) => (
                  <span>{label}</span>
                ))}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section knowledge-section knowledge-start-section">
    <div class="shell">
      <SectionHeader
        index="02 / Start here"
        title="Good entry"
        emphasis="points."
        icon="knowledge"
        description="Manually curated starting points for readers who want a useful first page."
      />
      <div class="knowledge-start-grid">
        {startHere.map((item) => (
          <a class="knowledge-start-card" href={item.slug}>
            <span>
              {knowledgeKindLabel(item.knowledge_kind)} ·{' '}
              {domainTitleById.get(item.knowledge_domain)}
            </span>
            <div class="content-item-title">
              <SemanticIcon name="knowledge" />
              <h3>{item.title}</h3>
            </div>
            <p>{item.description}</p>
            <small>{knowledgePathLabel(item.knowledge_area ?? [])}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section knowledge-section">
    <div class="shell">
      <a class="knowledge-explore-all" href="/knowledge/all">
        <span class="knowledge-explore-all-copy">
          <SemanticIcon name="knowledge" />
          <span>
            <strong>Browse all Knowledge</strong>
            <small>Search, filter by domain or kind, and sort across every reference page.</small>
          </span>
        </span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
