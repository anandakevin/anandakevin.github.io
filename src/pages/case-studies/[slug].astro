---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fixtureWriting } from '../../data/fixtures';
import MarkdownBody from '../../components/MarkdownBody.astro';
import AtlasNeighborhood from '../../components/AtlasNeighborhood.astro';
import SketchEmbeds from '../../components/SketchEmbeds.astro';
import {
  entryToPublicContent,
  getCaseStudyEntriesForRoutes,
  getRecordsById,
  isFixtureMode,
  slugTail,
  sketchesUsedIn,
} from '../../lib/content';

export async function getStaticPaths() {
  if (isFixtureMode) {
    return fixtureWriting
      .filter((item) => item.content_kind === 'case_study')
      .map((item) => ({
        params: { slug: slugTail(item.slug) },
        props: { fixture: item },
      }));
  }

  const entries = await getCaseStudyEntriesForRoutes();
  return entries.map((entry) => ({
    params: { slug: slugTail(entry.data.slug) },
    props: { entry },
  }));
}

const props = Astro.props as {
  fixture?: (typeof fixtureWriting)[number];
  entry?: import('astro:content').CollectionEntry<'writing'>;
};
const fixture = props.fixture;
const entry = props.entry;
const byId = await getRecordsById();

let title = '';
let description = '';
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let embeddedSketches = [] as import('../../lib/public-contract').PublicContent[];

if (fixture) {
  title = fixture.title;
  description = fixture.description;
} else if (entry) {
  title = entry.data.title;
  description = entry.data.description;
  ({ Content } = await render(entry));
  embeddedSketches = sketchesUsedIn([...byId.values()], entry.data.id);
}
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="shell">
      <p class="page-crumb">Writing / case study{isFixtureMode ? ' fixture' : ''}</p>
      <h1 class="display">{title}</h1>
      <p class="lede">{description}</p>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      {fixture ? (
        <div class="detail-list">
          <div class="detail-row">
            <small>Context</small>
            <div>
              <h3>Fixture content is visibly isolated.</h3>
              <p>No prototype example has been promoted to a factual case study.</p>
            </div>
            <a href="/writing">Writing ↗</a>
          </div>
          <div class="detail-row">
            <small>Reasoning</small>
            <div>
              <h3>The public contract precedes public claims.</h3>
              <p>
                The final Case Study must arrive from reviewed public-site content, with sanitized
                evidence and explicit source relationships.
              </p>
            </div>
            <a href="/work">Work ↗</a>
          </div>
        </div>
      ) : Content ? (
        <>
          <MarkdownBody>
            <Content />
          </MarkdownBody>
          <SketchEmbeds sketches={embeddedSketches} />
          <div class="actions">
            <a class="button alt" href="/writing">
              Back to writing ↗
            </a>
          </div>
        </>
      ) : null}
    </div>
  </section>
  {entry && <AtlasNeighborhood item={entryToPublicContent(entry)} records={[...byId.values()]} />}
</BaseLayout>
