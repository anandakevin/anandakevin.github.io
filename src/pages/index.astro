---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SystemTrace from '../components/SystemTrace.astro';
import WorkCard from '../components/WorkCard.astro';
import FeaturedWriting from '../components/FeaturedWriting.astro';
import { fixtureContributions, fixtureNotice, fixtureProjects, fixtureThroughlines, fixtureWork, fixtureWriting } from '../data/fixtures';
---
<BaseLayout title="Portfolio foundation" description={fixtureNotice}>
  <section class="home-hero"><div class="shell"><p class="eyebrow"><b></b>Portfolio foundation / fixture mode</p><h1 class="display">Building systems that make good work <em>easier to do.</em></h1><p class="lede">This implementation validates the approved experience and public-content boundary. Visitor-facing facts remain deliberately absent until reviewed public records exist.</p><div class="actions"><a class="button" href="/work">Explore fixture work ↗</a><a class="button alt" href="/writing">Inspect fixture writing ↗</a></div><div class="detail-pills"><span>mode · implementation fixture</span><span>content · not yet reviewed</span><span>theme · light / dark</span></div></div></section>
  <section class="section"><div class="shell"><SystemTrace /><p class="process-coda"><span>observe</span> → <span>clarify</span> → <span>build</span> <b>↻</b> <em>trade-offs stay visible</em></p></div></section>
  <section class="section"><div class="shell"><SectionHeader index="01 / Selected work" title="Systems work, not a wall of" emphasis="job titles." description="Fixture cards verify hierarchy, signal placement, contextual stacks, and responsive collapse." /><div class="work-list">{fixtureWork.map((item, index) => <WorkCard item={item} signal={index === 0 ? 'complexity → clarity' : 'manual work → leverage'} />)}</div></div></section>
  <section class="section"><div class="shell"><SectionHeader index="02 / Featured writing" title="Deep reasoning has a" emphasis="real surface." description="The fixture uses two clearly-labelled items to exercise the approved tab, progress, pause, manual-selection, and depth states." /><FeaturedWriting items={fixtureWriting} /></div></section>
  <section class="section"><div class="shell"><SectionHeader index="03 / Throughlines" title="Recurring engineering instincts, backed by" emphasis="evidence." description="These are implementation fixtures only. Production throughlines require an approved registry and assigned public records." /><div class="throughlines">{fixtureThroughlines.map((item, index) => <article class="throughline-card"><small>{String(index + 1).padStart(2, '0')} / fixture</small><h3>{item.title}</h3><p>{item.description}</p><span>Seen in · reviewed evidence pending</span></article>)}</div></div></section>
  <section class="section"><div class="shell"><SectionHeader index="04 / Projects" title="Discrete artifacts deserve their own" emphasis="context." /><div class="three-grid">{fixtureProjects.map((item) => <article class="artifact-card"><small>Project / fixture</small><h3>{item.title}</h3><p>{item.description}</p><a href="/projects">Open fixture projects ↗</a></article>)}<article class="artifact-card"><small>Optional media</small><h3>Graceful absence is intentional.</h3><p>Production cards support public assets when evidence calls for them; imagery is not fabricated to fill a layout.</p></article></div></div></section>
  <section class="section"><div class="shell"><SectionHeader index="05 / Contribution" title="Technical work becomes more useful when it can be" emphasis="passed on." /><div class="three-grid">{fixtureContributions.map((item) => <article class="artifact-card"><small>Contribution / fixture</small><h3>{item.title}</h3><p>{item.description}</p><a href="/contributions">Open fixture contributions ↗</a></article>)}<article class="artifact-card"><small>Evidence rule</small><h3>Metrics arrive with context.</h3><p>No contribution numbers appear until their source, denominator, and public suitability are reviewed.</p></article></div></div></section>
</BaseLayout>
