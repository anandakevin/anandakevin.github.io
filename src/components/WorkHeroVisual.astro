<div
  class="work-hero-visual"
  role="img"
  aria-label="A work path connecting context, constraints, decisions, and outcomes"
>
  <svg viewBox="0 0 560 360" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="work-hero-grid" width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M 28 0 L 0 0 0 28" class="work-hero-grid-line" />
      </pattern>
    </defs>
    <rect width="560" height="360" rx="22" class="work-hero-frame" />
    <rect x="1" y="1" width="558" height="358" rx="21" fill="url(#work-hero-grid)" />

    <path
      d="M72 229 C126 187 166 190 218 229 S306 272 356 224 S434 151 493 188"
      class="work-hero-path"
    />
    <path
      d="M74 96 C141 70 186 105 241 91 S351 57 481 98"
      class="work-hero-path work-hero-path--quiet"
    />

    <g class="work-hero-node work-hero-node--context">
      <circle cx="72" cy="229" r="7" />
      <text x="72" y="260" text-anchor="middle">
        CONTEXT
      </text>
      <text x="72" y="276" text-anchor="middle" class="work-hero-node-detail">
        what matters
      </text>
    </g>
    <g class="work-hero-node work-hero-node--constraints">
      <circle cx="218" cy="229" r="7" />
      <text x="218" y="198" text-anchor="middle">
        CONSTRAINTS
      </text>
      <text x="218" y="182" text-anchor="middle" class="work-hero-node-detail">
        what changes
      </text>
    </g>
    <g class="work-hero-node work-hero-node--decision">
      <circle cx="356" cy="224" r="7" />
      <text x="356" y="256" text-anchor="middle">
        DECISION
      </text>
      <text x="356" y="272" text-anchor="middle" class="work-hero-node-detail">
        what holds
      </text>
    </g>
    <g class="work-hero-node work-hero-node--outcome">
      <circle cx="493" cy="188" r="7" />
      <text x="493" y="157" text-anchor="middle">
        OUTCOME
      </text>
      <text x="493" y="141" text-anchor="middle" class="work-hero-node-detail">
        what lasts
      </text>
    </g>

    <g class="work-hero-card" transform="rotate(-5 292 108)">
      <rect x="236" y="66" width="112" height="75" rx="9" />
      <path d="M251 88 H309 M251 101 H329 M251 114 H293" />
      <circle cx="326" cy="87" r="5" />
    </g>
    <text x="28" y="34" class="work-hero-caption">
      ENGINEERING WORK / DECISION TRACE
    </text>
    <text x="532" y="34" text-anchor="end" class="work-hero-caption">
      DECISION TRACE
    </text>
  </svg>
  <div class="work-hero-visual-foot" aria-hidden="true">
    <span>problem / responsibility</span>
    <span>decision / outcome →</span>
  </div>
</div>
