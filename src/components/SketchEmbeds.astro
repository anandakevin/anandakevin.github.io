---
import type { PublicContent } from '../lib/public-contract';
import SketchEmbed from './SketchEmbed.astro';

interface Props {
  sketches: PublicContent[];
}

const { sketches } = Astro.props;
---

{sketches.map((sketch) => (
  <SketchEmbed
    sketch={sketch}
    caption="Shown here because the drawing exposes the relationships this page is explaining."
  />
))}
