---
const indexUrl = `${import.meta.env.BASE_URL}knowledge/search-index.json`;
---

<div class="knowledge-search-modal" data-knowledge-search-modal hidden>
  <div class="knowledge-search-backdrop" data-knowledge-search-close></div>
  <section
    class="knowledge-search-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="knowledge-search-title"
  >
    <div class="knowledge-search-dialog-head">
      <p id="knowledge-search-title">Search Knowledge</p>
      <button type="button" data-knowledge-search-close aria-label="Close Knowledge search">
        Esc
      </button>
    </div>
    <label class="knowledge-search-input-label">
      <span class="sr-only">Search Knowledge pages and areas</span>
      <input
        data-knowledge-search-input
        type="search"
        placeholder="Search pages, domains, or areas…"
        autocomplete="off"
        aria-controls="knowledge-search-results"
        aria-autocomplete="list"
      />
    </label>
    <div
      id="knowledge-search-results"
      class="knowledge-search-results"
      role="listbox"
      aria-label="Knowledge search results"
    ></div>
    <a class="knowledge-search-all" data-knowledge-search-all href="/knowledge/all/">
      View all results →
    </a>
    <p class="knowledge-search-hint">↑ ↓ to move · Enter to open · Esc to close</p>
  </section>
</div>

<script define:vars={{ indexUrl }}>
  const normalizeKnowledgeSearch = (value) =>
    value
      .normalize('NFKD')
      .replace(/\p{Diacritic}/gu, '')
      .toLocaleLowerCase()
      .trim();
  const modal = document.querySelector('[data-knowledge-search-modal]');
  const input = modal?.querySelector('[data-knowledge-search-input]');
  const results = modal?.querySelector('[data-knowledge-search-results]');
  const allLink = modal?.querySelector('[data-knowledge-search-all]');
  const closeControls = modal?.querySelectorAll('[data-knowledge-search-close]');
  let pages = [];
  let nodes = [];
  let loaded = false;
  let loading;
  let activeIndex = -1;
  let returnFocus = null;

  const setActive = (index) => {
    const items = [...(results?.querySelectorAll('[role="option"]') ?? [])];
    activeIndex = items.length ? (index + items.length) % items.length : -1;
    items.forEach((item, itemIndex) => {
      item.classList.toggle('is-active', itemIndex === activeIndex);
      item.setAttribute('aria-selected', String(itemIndex === activeIndex));
    });
  };

  const render = () => {
    if (!results || !input || !allLink) return;
    const query = normalizeKnowledgeSearch(input.value);
    const matches = (item) => !query || item.search.includes(query);
    const pageMatches = pages.filter(matches).slice(0, 4);
    const nodeMatches = nodes.filter(matches).slice(0, 3);
    const totalMatches = pages.filter(matches).length + nodes.filter(matches).length;
    results.replaceChildren();
    activeIndex = -1;

    if (!pageMatches.length && !nodeMatches.length) {
      const empty = document.createElement('p');
      empty.className = 'knowledge-search-empty';
      empty.textContent = query
        ? 'No quick results. Try the full index.'
        : 'No Knowledge results yet.';
      results.append(empty);
    }

    const addHeading = (label) => {
      const heading = document.createElement('p');
      heading.className = 'knowledge-search-group';
      heading.textContent = label;
      results.append(heading);
    };
    const addItem = (item, type) => {
      const link = document.createElement('a');
      link.className = 'knowledge-search-result';
      link.href = item.href;
      link.setAttribute('role', 'option');
      link.setAttribute('aria-selected', 'false');
      const title = document.createElement('strong');
      title.textContent = item.title;
      const meta = document.createElement('span');
      meta.textContent =
        type === 'page'
          ? `${item.kindLabel} · ${item.domainLabel}${item.pathLabel ? ` · ${item.pathLabel}` : ''}`
          : `${type === 'domain' ? 'Domain' : 'Area'} · ${item.domain}${item.pathLabel ? ` · ${item.pathLabel}` : ''}`;
      link.append(title, meta);
      results.append(link);
    };

    if (pageMatches.length) {
      addHeading('Pages');
      pageMatches.forEach((item) => addItem(item, 'page'));
    }
    if (nodeMatches.length) {
      addHeading('Maps');
      nodeMatches.forEach((item) => addItem(item, item.type));
    }
    allLink.href = `/knowledge/all/?${query ? `q=${encodeURIComponent(input.value.trim())}` : ''}`;
    allLink.textContent =
      totalMatches > 7 ? `View all ${totalMatches} results →` : 'View all results →';
  };

  const load = async () => {
    if (loaded || !indexUrl) return;
    loading ??= fetch(indexUrl, { headers: { Accept: 'application/json' } })
      .then(async (response) => {
        if (!response.ok) throw new Error(`Search index returned ${response.status}`);
        const payload = await response.json();
        pages = Array.isArray(payload.items) ? payload.items : [];
        nodes = Array.isArray(payload.nodes) ? payload.nodes : [];
        loaded = true;
      })
      .catch(() => {
        pages = [];
        nodes = [];
      });
    await loading;
  };

  const close = () => {
    if (!modal) return;
    modal.hidden = true;
    document.body.classList.remove('knowledge-search-open');
    returnFocus?.focus();
    returnFocus = null;
  };

  const open = async (trigger) => {
    if (!modal || !input) return;
    returnFocus =
      trigger ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
    modal.hidden = false;
    document.body.classList.add('knowledge-search-open');
    input.value = '';
    render();
    input.focus();
    await load();
    render();
  };

  closeControls?.forEach((control) => control.addEventListener('click', close));
  input?.addEventListener('input', render);
  input?.addEventListener('keydown', (event) => {
    const items = [...(results?.querySelectorAll('[role="option"]') ?? [])];
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setActive(activeIndex + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setActive(activeIndex - 1);
    } else if (event.key === 'Enter' && activeIndex >= 0 && items[activeIndex]) {
      event.preventDefault();
      items[activeIndex].click();
    } else if (event.key === 'Escape') {
      event.preventDefault();
      close();
    }
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      void open(document.activeElement instanceof HTMLElement ? document.activeElement : undefined);
    } else if (event.key === 'Escape' && modal && !modal.hidden) {
      close();
    }
  });
  document.querySelectorAll('[data-knowledge-search-trigger]').forEach((trigger) => {
    trigger.addEventListener('focus', () =>
      trigger.setAttribute('aria-keyshortcuts', 'Control+K Meta+K'),
    );
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      void open(trigger);
    });
  });
</script>
