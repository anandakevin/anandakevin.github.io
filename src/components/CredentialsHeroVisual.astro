<div
  class="credentials-hero-visual"
  role="img"
  aria-label="A verification trail connecting education, research, and public recognition"
>
  <svg viewBox="0 0 560 360" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="credentials-hero-grid" width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M 28 0 L 0 0 0 28" class="credentials-hero-grid-line" />
      </pattern>
    </defs>
    <rect width="560" height="360" rx="22" class="credentials-hero-frame" />
    <rect x="1" y="1" width="558" height="358" rx="21" fill="url(#credentials-hero-grid)" />

    <path
      d="M92 104 C150 98 178 133 218 169 S302 224 360 187 S425 128 468 112"
      class="credentials-hero-path credentials-hero-path--quiet"
    />
    <path
      d="M92 254 C152 254 177 214 218 169 S306 120 360 187 S419 254 468 253"
      class="credentials-hero-path"
    />

    <g class="credentials-hero-record" transform="rotate(-4 282 170)">
      <rect x="194" y="102" width="178" height="136" rx="12" />
      <path d="M220 136 H321 M220 151 H348 M220 166 H302" />
      <path d="M220 197 H284 M220 212 H322" />
      <circle cx="337" cy="132" r="12" />
      <path d="M331 132 L336 137 L344 127" />
      <text x="220" y="122">
        PUBLIC RECORD
      </text>
    </g>

    <g class="credentials-hero-node credentials-hero-node--education">
      <circle cx="92" cy="104" r="7" />
      <text x="92" y="75" text-anchor="middle">
        EDUCATION
      </text>
      <text x="92" y="59" text-anchor="middle" class="credentials-hero-node-detail">
        learn / qualify
      </text>
    </g>
    <g class="credentials-hero-node credentials-hero-node--research">
      <circle cx="468" cy="112" r="7" />
      <text x="468" y="83" text-anchor="middle">
        RESEARCH
      </text>
      <text x="468" y="67" text-anchor="middle" class="credentials-hero-node-detail">
        ask / publish
      </text>
    </g>
    <g class="credentials-hero-node credentials-hero-node--recognition">
      <circle cx="92" cy="254" r="7" />
      <text x="92" y="286" text-anchor="middle">
        RECOGNITION
      </text>
      <text x="92" y="302" text-anchor="middle" class="credentials-hero-node-detail">
        earn / contribute
      </text>
    </g>
    <g class="credentials-hero-node credentials-hero-node--verify">
      <circle cx="468" cy="253" r="7" />
      <text x="468" y="285" text-anchor="middle">
        VERIFY
      </text>
      <text x="468" y="301" text-anchor="middle" class="credentials-hero-node-detail">
        follow the source
      </text>
    </g>

    <text x="28" y="34" class="credentials-hero-caption">
      PUBLIC RECORD / VERIFICATION TRAIL
    </text>
    <text x="532" y="34" text-anchor="end" class="credentials-hero-caption">
      VERIFICATION TRAIL
    </text>
  </svg>
  <div class="credentials-hero-visual-foot" aria-hidden="true">
    <span>education / research</span>
    <span>recognition →</span>
  </div>
</div>
