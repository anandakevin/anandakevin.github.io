---
import { elsewhereLinksWithHref } from '../data/approved-elsewhere';
---

<footer class="site-footer">
  <div class="shell">
    <p class="footer-motto">
      Build <em>Systems.</em> Create <em>Leverage.</em> Leave Lasting <em>Impact.</em>
    </p>
    <div class="footer-directory">
      <p class="footer-blurb">Engineering work, projects, writing, and teaching.</p>
      <div class="footer-group">
        <span class="footer-group-label">Explore</span>
        <a href="/work">Work</a>
        <a href="/projects">Projects</a>
        <a href="/writing">Writing</a>
        <a href="/knowledge">Knowledge</a>
        <a href="/contributions">Contributions</a>
        <a href="/about">About</a>
      </div>
      <div class="footer-group">
        <span class="footer-group-label">More</span>
        <a href="/explore">Explore</a>
        <a href="/credentials">Credentials & Recognition</a>
      </div>
      <div class="footer-group">
        <span class="footer-group-label">Elsewhere</span>
        {elsewhereLinksWithHref.map((link) => (
          <a
            href={link.href}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            target={link.href.startsWith('http') ? '_blank' : undefined}
          >
            {link.label} ↗
          </a>
        ))}
      </div>
    </div>
    <div class="footer-bottom">
      <span>Ananda Kevin</span>
      <span>system · software · explanation</span>
    </div>
  </div>
</footer>
