---
import { elsewhereLinksWithHref } from '../data/approved-elsewhere';
import { corpusNavigation, portfolioNavigation } from '../data/site-navigation';
---

<footer class="site-footer">
  <div class="shell">
    <p class="footer-motto">
      Build <em>Systems.</em> Create <em>Leverage.</em> Leave Lasting <em>Impact.</em>
    </p>
    <div class="footer-directory">
      <p class="footer-blurb">
        Portfolio work, projects, contributions, and credentials alongside a public corpus of
        writing, knowledge, and sketches.
      </p>
      <div class="footer-group">
        <span class="footer-group-label">Portfolio</span>
        {portfolioNavigation.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </div>
      <div class="footer-group">
        <span class="footer-group-label">Corpus</span>
        {corpusNavigation.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </div>
      <div class="footer-group">
        <span class="footer-group-label">Navigate</span>
        <a href="/about">About</a>
        <a href="/explore">Atlas</a>
      </div>
      <div class="footer-group">
        <span class="footer-group-label">Elsewhere</span>
        {elsewhereLinksWithHref.map((link) => (
          <a
            href={link.href}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            target={link.href.startsWith('http') ? '_blank' : undefined}
          >
            {link.label} ↗
          </a>
        ))}
      </div>
    </div>
    <div class="footer-bottom">
      <span>Ananda Kevin</span>
      <span>system · software · explanation</span>
    </div>
  </div>
</footer>
