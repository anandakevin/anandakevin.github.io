---
import type { PublicContent } from '../lib/public-contract';
import { fieldNoteSectionById } from '../data/writing-sections';

interface Props {
  item: PublicContent;
  fixtureMode?: boolean;
}

const { item, fixtureMode = false } = Astro.props;
const href = item.slug.startsWith('/') ? item.slug : `/${item.slug}`;
const isFieldNote = item.writing_mode === 'reference';
const fieldNoteSection = fieldNoteSectionById.get(item.field_note_section ?? 'engineering-systems');
const kindLabels: Record<string, string> = {
  case_study: 'Case study',
  article: 'Article',
  note: 'Note',
};
const kindLabel = isFieldNote
  ? `Field note · ${fieldNoteSection?.title ?? 'Reference'}`
  : fixtureMode
    ? `Fixture / ${kindLabels[item.content_kind] ?? item.content_kind}`
    : (kindLabels[item.content_kind] ?? item.content_kind.replaceAll('_', ' '));

function formatDate(value?: string) {
  if (!value) return 'Review date not recorded';
  const date = new Date(`${value}T00:00:00Z`);
  if (Number.isNaN(date.valueOf())) return value;
  return new Intl.DateTimeFormat('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);
}
---

<article
  class="writing-index-row"
  data-feed-kind={item.content_kind}
  data-writing-mode={item.writing_mode}
>
  <p class="writing-index-row-type">{kindLabel}</p>
  <div class="writing-index-row-main">
    <h3>
      <a href={href}>{item.title}</a>
    </h3>
    <p>{item.description}</p>
  </div>
  <div class="writing-index-row-meta">
    {isFieldNote ? (
      <time datetime={item.last_verified}>Reviewed {formatDate(item.last_verified)}</time>
    ) : (
      <a href={href} aria-label={`Open ${item.title}`}>
        {item.content_kind === 'case_study' ? 'Open case study' : 'Read'}{' '}
        <span class="link-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    )}
  </div>
</article>
