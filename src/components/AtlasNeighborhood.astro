---
import SystemsMap from './SystemsMap.astro';
import type { PublicContent } from '../lib/public-contract';
import { buildSystemsMapGraph } from '../lib/systems-map-graph';

interface Props {
  item: PublicContent;
  records: PublicContent[];
}

const { item, records } = Astro.props;
const graph = buildSystemsMapGraph(records);
const artifact = graph.artifacts.find((candidate) => candidate.id === item.id);
const atlasFocusHref = `/explore/?focus=${encodeURIComponent(item.id)}`;
---

{artifact && (
  <section class="atlas-neighborhood" aria-labelledby={`atlas-neighborhood-${item.id}`}>
    <div class="shell">
      <div class="atlas-neighborhood-heading">
        <div>
          <p class="section-index">Atlas context</p>
          <h2 id={`atlas-neighborhood-${item.id}`}>
            Nearby in the <em>public corpus.</em>
          </h2>
          <p class="atlas-neighborhood-description">
            This artifact is highlighted; connected nodes are reviewed relations.
          </p>
        </div>
        <a class="atlas-neighborhood-open" href={atlasFocusHref}>
          Explore the full atlas →
        </a>
      </div>
      <div class="atlas-neighborhood-map">
        <SystemsMap records={records} focusId={item.id} mode="context" />
      </div>
    </div>
  </section>
)}
