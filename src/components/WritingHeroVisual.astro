<div
  class="writing-hero-visual"
  role="img"
  aria-label="A stack of writing notes moving from draft to review to publication"
>
  <svg viewBox="0 0 560 360" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="writing-hero-grid" width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M 28 0 L 0 0 0 28" class="writing-hero-grid-line" />
      </pattern>
    </defs>
    <rect width="560" height="360" rx="22" class="writing-hero-frame" />
    <rect x="1" y="1" width="558" height="358" rx="21" fill="url(#writing-hero-grid)" />

    <path
      d="M72 273 C144 242 162 292 230 256 S338 184 405 218 S457 276 493 236"
      class="writing-hero-path"
    />
    <path
      d="M85 103 C154 63 198 88 256 117 S358 145 466 96"
      class="writing-hero-path writing-hero-path--quiet"
    />

    <g class="writing-hero-sheet writing-hero-sheet--back" transform="rotate(-7 275 164)">
      <rect x="163" y="88" width="224" height="150" rx="12" />
      <path d="M187 126 H337 M187 142 H359 M187 158 H317" />
      <path d="M187 190 H286 M187 206 H335" />
      <text x="187" y="110">
        01 / DRAFT
      </text>
    </g>
    <g class="writing-hero-sheet writing-hero-sheet--front" transform="rotate(5 302 185)">
      <rect x="203" y="119" width="224" height="150" rx="12" />
      <path d="M227 157 H377 M227 173 H399 M227 189 H357" />
      <path d="M227 221 H326 M227 237 H375" />
      <circle cx="386" cy="143" r="6" />
      <text x="227" y="141">
        02 / REVIEW
      </text>
    </g>

    <g class="writing-hero-mark writing-hero-mark--left">
      <circle cx="72" cy="273" r="7" />
      <text x="72" y="301" text-anchor="middle">
        NOTICE
      </text>
      <text x="72" y="317" text-anchor="middle" class="writing-hero-mark-detail">
        make it clear
      </text>
    </g>
    <g class="writing-hero-mark writing-hero-mark--right">
      <circle cx="493" cy="236" r="7" />
      <text x="493" y="267" text-anchor="middle">
        SHARE
      </text>
      <text x="493" y="283" text-anchor="middle" class="writing-hero-mark-detail">
        make it useful
      </text>
    </g>

    <text x="28" y="34" class="writing-hero-caption">
      WORKING LIBRARY / EDITORIAL FIELD
    </text>
    <text x="532" y="34" text-anchor="end" class="writing-hero-caption">
      EDITORIAL FIELD
    </text>
  </svg>
  <div class="writing-hero-visual-foot" aria-hidden="true">
    <span>draft / review</span>
    <span>share what holds →</span>
  </div>
</div>
