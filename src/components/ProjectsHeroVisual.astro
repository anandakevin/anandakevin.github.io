<div
  class="projects-hero-visual"
  role="img"
  aria-label="A project path from question to build to experiment to useful result"
>
  <svg viewBox="0 0 560 360" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="project-hero-grid" width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M 28 0 L 0 0 0 28" class="projects-hero-grid-line" />
      </pattern>
    </defs>
    <rect width="560" height="360" rx="22" class="projects-hero-frame" />
    <rect x="1" y="1" width="558" height="358" rx="21" fill="url(#project-hero-grid)" />

    <path
      d="M92 94 C154 50 194 65 244 111 S337 183 397 143 S456 93 484 118"
      class="projects-hero-path projects-hero-path--quiet"
    />
    <path
      d="M76 266 C144 238 171 276 231 243 S337 193 397 224 S450 282 492 244"
      class="projects-hero-path"
    />

    <g class="projects-hero-node projects-hero-node--question">
      <circle cx="76" cy="266" r="7" />
      <text x="76" y="294" text-anchor="middle">
        QUESTION
      </text>
      <text x="76" y="310" text-anchor="middle" class="projects-hero-node-detail">
        why / what if
      </text>
    </g>
    <g class="projects-hero-node projects-hero-node--build">
      <circle cx="231" cy="243" r="7" />
      <text x="231" y="215" text-anchor="middle">
        BUILD
      </text>
      <text x="231" y="199" text-anchor="middle" class="projects-hero-node-detail">
        make it real
      </text>
    </g>
    <g class="projects-hero-node projects-hero-node--experiment">
      <circle cx="397" cy="224" r="7" />
      <text x="397" y="262" text-anchor="middle">
        EXPERIMENT
      </text>
      <text x="397" y="278" text-anchor="middle" class="projects-hero-node-detail">
        learn / adjust
      </text>
    </g>
    <g class="projects-hero-node projects-hero-node--result">
      <circle cx="492" cy="244" r="7" />
      <text x="492" y="216" text-anchor="middle">
        RESULT
      </text>
      <text x="492" y="200" text-anchor="middle" class="projects-hero-node-detail">
        useful enough
      </text>
    </g>

    <g class="projects-hero-card" transform="rotate(-5 304 110)">
      <rect x="248" y="73" width="112" height="75" rx="9" />
      <path d="M263 95 H321 M263 108 H343 M263 121 H305" />
      <circle cx="338" cy="94" r="5" />
    </g>
    <text x="28" y="34" class="projects-hero-caption">
      INDEPENDENT BUILDS / FIELD NOTE
    </text>
    <text x="532" y="34" text-anchor="end" class="projects-hero-caption">
      FIELD NOTE
    </text>
  </svg>
  <div class="projects-hero-visual-foot" aria-hidden="true">
    <span>from curiosity</span>
    <span>to something useful →</span>
  </div>
</div>
