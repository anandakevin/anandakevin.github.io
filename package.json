{
  "name": "anandakevin.github.io",
  "version": "1.0.0",
  "description": "My Portfolio",
  "main": "index.js",
  "scripts": {
    "dev": "npm run content:refresh-medium && ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTENT_MODE=preview astro dev",
    "dev:production": "npm run content:refresh-medium && ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTENT_MODE=production astro dev",
    "dev:fixtures": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTENT_MODE=fixtures astro dev",
    "build": "npm run content:refresh-medium && node scripts/assert-public-content.mjs && ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTENT_MODE=production astro build",
    "build:staging": "npm run content:refresh-medium && ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTENT_MODE=preview astro build",
    "build:preview": "npm run build:staging",
    "build:publish": "npm run content:refresh-medium && node scripts/assert-public-content.mjs && ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTENT_MODE=publish astro build",
    "build:fixtures": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_CONTENT_MODE=fixtures astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:production": "npm run build && npm run preview",
    "preview:staging": "npm run build:staging && npm run preview",
    "format": "prettier --write \".github/**/*.{yml,yaml}\" \"docs/**/*.md\" \"scripts/**/*.{html,js,mjs}\" \"src/**/*.{astro,css,scss,html,js,mjs,ts,json,md,yml,yaml}\" \"*.{html,js,mjs,ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \".github/**/*.{yml,yaml}\" \"docs/**/*.md\" \"scripts/**/*.{html,js,mjs}\" \"src/**/*.{astro,css,scss,html,js,mjs,ts,json,md,yml,yaml}\" \"*.{html,js,mjs,ts,json,md,yml,yaml}\"",
    "lint": "eslint . --ext .js,.mjs,.ts,.astro --no-error-on-unmatched-pattern",
    "type-check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "content:check": "node scripts/check-public-content.mjs",
    "test": "node --experimental-strip-types --test scripts/check-public-content.test.mjs scripts/contribution-metrics.test.mjs scripts/external-writing.test.mjs scripts/knowledge-index.test.mjs",
    "content:refresh-adplist": "node scripts/content-refresh-adplist.mjs",
    "content:refresh-medium": "node --experimental-strip-types --experimental-default-type=module scripts/content-refresh-medium.mjs",
    "deploy": "npm run format:check && npm run lint && npm run content:check && npm test && npm run type-check && npm run build",
    "deploy:publish": "npm run format:check && npm run lint && npm run content:check && npm test && npm run type-check && npm run build:publish",
    "publish": "npm run deploy:publish && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anandakevin/anandakevin.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anandakevin/anandakevin.github.io/issues"
  },
  "homepage": "https://github.com/anandakevin/anandakevin.github.io#readme",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "gh-pages": "^6.3.0",
    "globals": "^13.24.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@excalidraw/excalidraw": "^0.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "astro": "^7.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
